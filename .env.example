# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# Both values are safe to expose to the browser: the anon key is protected by
# the Row Level Security policies in `supabase/schema.sql`. Never place the
# service-role key in this file.
#
# The site builds and renders without any of these. Missing values degrade
# gracefully: Supabase-backed features report that they are unconfigured and
# `POST /api/contact` returns 503 instead of silently discarding an enquiry.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server-only. NEVER prefix with NEXT_PUBLIC_, never commit, never
# expose to the browser. Required for the admin dashboard, which reads and
# updates contact messages using the service role.
#
# Find it under Project Settings > API > service_role. Treat a leaked key as a
# full database compromise and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site URL — used for canonical URLs, Open Graph, JSON-LD and the sitemap.
# Set this to the real domain in production; leave localhost for local dev.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact-form email notifications — fully optional.
#
# The enquiry is always written to Supabase first, so the form works with none
# of these set. With them set, a notification is sent after a successful insert;
# a notification failure is logged and never fails the visitor's submission.
# ---------------------------------------------------------------------------
CONTACT_NOTIFICATION_EMAIL=laxmichy0722@gmail.com

# Provider: Resend — https://resend.com/api-keys
# The sender must be a domain you have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Salt for hashing submitting IP addresses before they are stored alongside a
# contact message. Used only for duplicate-abuse triage — never reversible to an
# address. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
CONTACT_IP_SALT=